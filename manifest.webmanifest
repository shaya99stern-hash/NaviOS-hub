{
  "name": "NaviOS Hub",
  "short_name": "NaviOS",
  "description": "Deep iPhone diagnostics. On-device probes plus a companion agent on your computer.",
  "id": "/navios-hub",
  "start_url": "./NaviOS%20Hub%20App.dc.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "fullscreen"
  ],
  "orientation": "portrait",
  "background_color": "#1b1917",
  "theme_color": "#1b1917",
  "categories": [
    "utilities",
    "productivity"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Run full scan",
      "url": "./NaviOS%20Hub%20App.dc.html?autoscan=1"
    },
    {
      "name": "Battery",
      "url": "./NaviOS%20Hub%20App.dc.html?view=battery"
    },
    {
      "name": "Spyware scan",
      "url": "./NaviOS%20Hub%20App.dc.html?view=spyware"
    }
  ]
}
